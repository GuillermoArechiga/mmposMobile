{
  "expo": {
    "name": "MMPos",
    "slug": "mmpos-mobile",
    "version": "0.1.0",
    "scheme": "mmpos",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0b0c",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mmpos.mobile"
    },
    "android": {
      "package": "com.mmpos.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#040405"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0a0b0c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
