  "typography": {
    "fontDisplay": "'Plus Jakarta Sans', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontSans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "fontMono": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Courier New', monospace",
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem",
      "6xl": "3.75rem"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "black": 900
    },
    "lineHeight": {
      "tight": 1.15,
      "snug": 1.35,
      "normal": 1.5,
      "ticket": 1.45
    },
    "bundling": "Both faces ship with the apps via @fontsource (Inter variable for UI, Plus Jakarta Sans 700/800 for display). Never rely on the OS having Inter — Windows tills do not.",
    "rules": [
      "Display (wordmark, page titles, hero numbers): Plus Jakarta Sans 800, tracking -0.02em.",
      "UI and body: Inter 400–700.",
      "Numbers in tables, totals and tickets use tabular-nums.",
      "Labels use 12px medium at 50–60% content."
    ]
  },
  "space": {
    "unit": "4px",
    "scale": [
      0,
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64
    ],
    "pageGutter": "16px",
    "cardPadding": "16px",
    "cardPaddingLarge": "24px"
  },
  "radius": {
    "selector": "0.5rem",
    "field": "0.375rem",
    "box": "0.75rem",
    "card": "0.75rem",
    "hero": "1rem",
    "pill": "9999px",
    "appIcon": "22.5%"
  },
  "border": {
    "width": "1px",
    "color": "base300"
  },
  "elevation": {
    "depth": 0,
    "noise": 0,
    "note": "Flat. Separate with borders; shadows only on modals (shadow-lg) and hover lift on tappable cards."
  },
  "motion": {
    "fast": "150ms",
    "base": "200ms",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "touch": {
    "minTarget": "44px",
    "button": "48px",
    "keypadKey": "96px",
    "note": "The Electron POS runs on touchscreens: controls in POS/shift flows are at least 48px."
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "note": "Below md the web Orders table becomes cards."
  },
